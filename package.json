{
  "name": "nusys-ui",
  "version": "3.3.1",
  "description": "Web components for creating Visual Studio Code extensions",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "type": "module",
  "types": "dist/main.d.ts",
  "files": [
    "dist",
    "custom-elements.json",
    "vscode.*-custom-data.json",
    "!dist/**/*.test.*"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && vite build --mode bundle && pnpm analyze && pnpm vscode-data",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf -g dist demo-dist coverage custom-elements.json vscode.*-custom-data.json",
    "lint": "eslint \"./src/**/*.ts\"",
    "lint:fix": "eslint \"./src/**/*.ts\" --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "analyze": "cem analyze --litelement --globs=\"src/**/*.ts\" --exclude=\"src/**/*.test.ts\" --exclude=\"src/includes/testing.ts\" --exclude=\"src/includes/test-helpers.ts\" --exclude=\"src/includes/browser-commands.ts\" --exclude=\"src/main.ts\" --exclude=\"src/*/index.ts\"",
    "start": "vite",
    "preview": "vite preview --outDir demo-dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "checksize": "pnpm build && node scripts/checksize.mjs",
    "icons": "node scripts/generateIconList.js",
    "vscode-data": "node scripts/generate-custom-data.mjs",
    "release": "node scripts/release.mjs",
    "test:release": "vitest run --project release",
    "test:install": "playwright install chromium --with-deps",
    "test:build": "node scripts/verify-build.mjs"
  },
  "keywords": [
    "web-components",
    "lit-element",
    "typescript"
  ],
  "author": "bendera",
  "license": "MIT",
  "browserslist": [
    "last 1 chrome versions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/171h/vscode-elements.git"
  },
  "bugs": {
    "url": "https://github.com/171h/vscode-elements/issues"
  },
  "homepage": "https://github.com/171h/vscode-elements#readme",
  "dependencies": {
    "@lit/context": "^1.1.3",
    "lit": "^3.2.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@vscode/codicons": ">=0.0.40"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@open-wc/testing-helpers": "^3.0.1",
    "@types/node": "^24.0.0",
    "@types/sinon": "^21.0.1",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vscode/codicons": "^0.0.46-24",
    "axe-core": "^4.13.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "custom-elements-manifest-deprecator": "^1.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-lit": "^2.0.0",
    "eslint-plugin-wc": "^3.0.0",
    "playwright": "^1.58.2",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "semver": "^7.7.1",
    "sinon": "^22.0.0",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "^5.8.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
