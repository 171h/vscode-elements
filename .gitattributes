# 自动识别文本文件并统一使用 LF 换行
* text=auto eol=lf

# 源代码
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf

# 文档
*.md text eol=lf

# 配置文件
*.yml text eol=lf
*.yaml text eol=lf
*.config text eol=lf
*.lock text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.ncurc text eol=lf
.mailmap text eol=lf

# 图形资源
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.ico binary
