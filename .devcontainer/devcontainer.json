{
  "name": "VSCode Elements Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "pnpmVersion": "12.8.1"
    }
  },
  "postCreateCommand": "pnpm install --frozen-lockfile && pnpm test:install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode",
        "runem.lit-plugin"
      ]
    }
  },
  "remoteUser": "vscode"
}
